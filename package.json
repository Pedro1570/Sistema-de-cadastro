{
  "name": "eleitoral-app",
  "version": "1.0.0",
  "description": "Sistema de Cadastro Eleitoral em Campo",
  "main": "server.js",
  "private": true,
  "scripts": {
    "frontend:install": "cd frontend && npm install && cd ..",
    "frontend:build": "cd frontend && npm run build && cd ..",
    "frontend:dev": "cd frontend && npm run dev && cd ..",
    "backend:start": "node server.js",
    "backend:dev": "nodemon server.js",
    "build": "npm run frontend:build",
    "start": "npm run backend:start",
    "dev": "npm run backend:dev",
    "cap:install": "npm install @capacitor/cli @capacitor/core @capacitor/android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:build": "npm run frontend:build && npx cap sync android && cd android && ./gradlew assembleRelease && cd .."
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
